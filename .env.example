# Copy to .env and fill in. Never commit .env.
# Only variables starting with VITE_ reach the browser. Everything else stays on the server.

# --- NEAR testnet: contract + web app ---
# Account the contract is deployed to, e.g. ajobridge.<your-account>.testnet
AJO_CONTRACT_ID=
VITE_AJO_CONTRACT_ID=
# Optional RPC overrides (default: https://test.rpc.fastnear.com)
NEAR_RPC_URL=
VITE_NEAR_RPC_URL=

# --- Alajo agent ---
# The agent account and its FUNCTION-CALL key (settle_round, post_note, finalize; zero deposit).
# Create the key with agent/setup-key.sh. Format: ed25519:...
ALAJO_ACCOUNT_ID=
ALAJO_PRIVATE_KEY=

# --- NEAR AI Cloud (OpenAI-compatible). Optional: without it Alajo uses built-in templates.
#     Key from https://cloud.near.ai, or $10 of credits via https://nearbuilders.org/dashboard ---
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V3.1

# --- NEAR Intents 1Click (mainnet only; there is no testnet). Optional JWT from https://partners.near-intents.org
#     removes the 0.2% unauthenticated fee. Server side only. ---
ONECLICK_JWT=

# --- Community: Google / email sign-in and invite links (Firebase). Optional: without them the
#     Community page says "being set up" and everything else works. Firebase web config is public
#     by design; access control lives in firestore.rules. Set these in Vercel too. See docs/community-setup.md ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Local development against the emulators instead (npx firebase-tools emulators:start --only auth,firestore)
# VITE_FIREBASE_EMULATOR=1
