# Copy to .env and fill in. Never commit .env.

# --- NEAR testnet (contract + web app) ---
NEAR_NETWORK=testnet
# Account the contract is deployed to, e.g. ajobridge.<your-account>.testnet
AJO_CONTRACT_ID=
VITE_AJO_CONTRACT_ID=

# --- Alajo agent (function-call key limited to settle_round / post_note / finalize, zero deposit) ---
ALAJO_ACCOUNT_ID=
ALAJO_PRIVATE_KEY=

# --- NEAR AI Cloud (OpenAI-compatible, https://cloud-api.near.ai/v1) ---
NEAR_AI_API_KEY=
NEAR_AI_MODEL=

# --- NEAR Intents 1Click (mainnet). Optional JWT removes the 0.25% unauthenticated fee; server-side only ---
ONECLICK_JWT=
